# Essential project files
include README.md
include pyproject.toml
include setup.py

# Package files  
include pytsfoil/VERSION
recursive-include pytsfoil *.py

# Fortran source files (needed for runtime compilation)
recursive-include pytsfoil *.f *.f90
recursive-include pytsfoil/src *.f *.f90

# Example files
recursive-include example *

# Exclude build artifacts and temporary files
global-exclude __pycache__ *.py[co] .git* .DS_Store *.egg-info
global-exclude *.so  # Compiled at runtime, not distributed
